{
  "name": "hades-army",
  "version": "0.8.0",
  "description": "Autonomous AI Development Army - Cloudflare Workers Edition",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply hades-db",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "hono": "^4.4.0",
    "drizzle-orm": "^0.31.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.4.0",
    "@cloudflare/workers-types": "^4.20240614.0",
    "drizzle-kit": "^0.22.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^7.0.0",
    "vitest": "^1.6.0",
    "wrangler": "^3.60.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "globals": "^15.0.0"
  }
}
